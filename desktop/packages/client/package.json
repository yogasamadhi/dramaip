{
  "name": "@dramaip/client",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./domains": "./src/domains/index.ts",
    "./errors": "./src/errors.ts",
    "./events": "./src/events.ts",
    "./transport": "./src/transport.ts"
  },
  "scripts": {
    "generate": "node ../../scripts/run-node.mjs --import tsx src/generate.ts",
    "check:generated": "node ../../scripts/run-node.mjs --import tsx src/generate.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dramaip/contracts": "workspace:*",
    "@dramaip/server-connection": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "^3.7.4"
  }
}
