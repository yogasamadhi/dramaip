{
  "name": "@dramaip/client",
  "version": "3.0.0-alpha.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./domains": "./src/domains/index.ts",
    "./errors": "./src/errors.ts",
    "./events": "./src/events.ts",
    "./transport": "./src/transport.ts"
  },
  "scripts": {
    "generate": "bun run src/generate.ts",
    "check:generated": "bun run src/generate.ts --check",
    "typecheck": "bun --bun run tsc --noEmit"
  },
  "dependencies": {
    "@dramaip/contracts": "workspace:*",
    "@dramaip/server-connection": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "^3.7.4"
  }
}
