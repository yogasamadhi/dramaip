{
  "name": "@dramaip/runtime",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "dramaip": "./bin/dramaip.mjs"
  },
  "scripts": {
    "serve": "node ../../scripts/run-node.mjs ../../scripts/runtime-supervisor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-node.mjs --expose-internals ../../node_modules/vitest/vitest.mjs run --maxWorkers=1 --passWithNoTests src"
  },
  "dependencies": {
    "@dramaip/contracts": "workspace:*",
    "@dramaip/bundles": "workspace:*",
    "@dramaip/server-connection": "workspace:*",
    "@dramaip/database": "workspace:*",
    "@dramaip/desktop-host": "workspace:*",
    "@dramaip/events": "workspace:*",
    "@dramaip/http": "workspace:*",
    "@dramaip/kernel": "workspace:*",
    "@dramaip/plugin-api": "workspace:*",
    "@dramaip/foundation": "workspace:*",
    "@dramaip/system": "workspace:*",
    "@dramaip/workspace": "workspace:*",
    "@dramaip/automation": "workspace:*",
    "@dramaip/writing": "workspace:*",
    "@dramaip/knowledge": "workspace:*",
    "@dramaip/agents": "workspace:*",
    "@dramaip/creative-quality": "workspace:*",
    "@dramaip/production": "workspace:*",
    "@dramaip/media": "workspace:*",
    "@dramaip/timeline": "workspace:*",
    "@dramaip/review": "workspace:*",
    "@dramaip/delivery": "workspace:*",
    "@dramaip/insights": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/runtime-adapters": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.9"
  },
  "engines": {
    "node": "24.18.0"
  }
}
