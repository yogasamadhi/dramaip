{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../packages/app/src/*"],
      "@dramaip/client": ["../../packages/client/src/index.ts"],
      "@dramaip/contracts": ["../../packages/contracts/src/index.ts"],
      "@dramaip/contracts/product": ["../../packages/contracts/src/product.ts"],
      "@dramaip/ui-runtime": ["../../packages/ui-runtime/src/index.ts"],
      "@dramaip/ui-shared": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "../../packages/app/src/**/*.ts",
    "../../packages/app/src/**/*.tsx",
    "../../packages/app/src/**/*.d.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/ui-runtime/src/**/*.ts"
  ],
  "exclude": [
    "../../packages/app/src/**/*.test.ts",
    "../../packages/app/src/**/*.test.tsx"
  ]
}
