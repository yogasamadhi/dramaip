{
  "name": "@sdns/desktop",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "DramaIP AI 漫剧生产工作室 - 桌面端",
  "author": "sdns",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun --bun run electron-vite dev",
    "build": "bun --bun run electron-vite build",
    "preview": "bun --bun run electron-vite preview",
    "build:opencode": "bun --cwd ../../vendor/opencode ./packages/opencode/script/build-node.ts && node scripts/prepare-opencode-runtime.mjs",
    "build:codex": "node scripts/prepare-codex-runtime.mjs",
    "build:dsh": "node scripts/prepare-dsh-runtime.mjs",
    "verify:dsh": "node scripts/verify-dsh-runtime.mjs",
    "build:pi": "node scripts/prepare-pi-runtime.mjs",
    "verify:pi": "node scripts/verify-pi-runtime.mjs",
    "build:grok": "node scripts/prepare-grok-runtime.mjs",
    "verify:grok": "node scripts/verify-grok-runtime.mjs",
    "update:codex-protocol": "node scripts/prepare-codex-runtime.mjs --update-protocol-lock",
    "package": "bun run build:opencode && bun run build:codex && bun run build:dsh && bun run verify:dsh && bun run build:pi && bun run verify:pi && bun run build:grok && bun run verify:grok && bun run build && bun --bun run electron-builder",
    "typecheck:node": "bun --bun run tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "bun --bun run tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web"
  },
  "dependencies": {
    "@sdns/client": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@openai/codex": "0.147.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "43.2.0",
    "electron-builder": "^26.11.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  }
}
