{
  "name": "@dramaip/desktop",
  "version": "3.0.0-alpha.3",
  "private": true,
  "description": "尽意 DramaIP——本地优先的 AI IP 创作工作台",
  "author": "sdns",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun ../../../run-desktop.ts",
    "dev:raw": "bun ../../scripts/dev-desktop.mjs",
    "build": "bun ../../scripts/build-runtime.mjs && bun --bun run electron-vite build",
    "preview": "bun --bun run electron-vite preview",
    "build:codex": "bun scripts/prepare-codex-runtime.mjs",
    "build:pi": "bun scripts/prepare-pi-runtime.mjs",
    "verify:pi": "bun scripts/verify-pi-runtime.mjs",
    "update:codex-protocol": "bun scripts/prepare-codex-runtime.mjs --update-protocol-lock",
    "package": "bun run build:codex && bun run build:pi && bun run verify:pi && bun run build && bun --bun run electron-builder",
    "typecheck:node": "bun --bun run tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "bun --bun run tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web"
  },
  "dependencies": {
    "@dramaip/client": "workspace:*",
    "@dramaip/contracts": "workspace:*",
    "@dramaip/extension-host": "workspace:*",
    "@dramaip/ui-runtime": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "htmlparser2": "8.0.2",
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "turndown": "7.2.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@dramaip/desktop-host": "workspace:*",
    "@dramaip/runtime": "workspace:*",
    "@dramaip/server-connection": "workspace:*",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "5.0.5",
    "@openai/codex": "0.147.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "43.2.0",
    "electron-builder": "^26.11.1",
    "electron-vite": "^5.0.0",
    "fflate": "0.8.3",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "@dramaip/runtime-adapters": "workspace:*"
  }
}
