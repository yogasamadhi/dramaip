{
  "name": "@dramaip/desktop2-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "../desktop/vendor/deepseek-harness/vendor/cordis",
    "../desktop/vendor/deepseek-harness/vendor/cosmokit",
    "../desktop/vendor/deepseek-harness/vendor/loader",
    "../desktop/vendor/deepseek-harness/vendor/group",
    "../desktop/vendor/deepseek-harness/vendor/include"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/studio dev",
    "build": "bun run check && bun run --cwd apps/studio build",
    "package": "bun run build && bun run --cwd apps/studio package",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test \"{apps,packages,plugins,tests}/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "bun run --cwd apps/studio test:e2e",
    "generate": "node --import tsx scripts/generate.mts && bunx openapi-typescript generated/openapi.json -o packages/client/src/generated/schema.d.ts",
    "capture:baseline": "bun scripts/capture-baseline-inventory.mts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run check:generated && bun run check:core-parity && bun run check:ui-parity && bun run check:architecture",
    "check:generated": "bun scripts/check-generated.mts",
    "check:architecture": "bun run check:no-effect && bun run check:no-legacy-imports && bun run check:no-node-runtime && bun run check:plugin-graph && bun run check:vendor-locks && bun run check:baseline",
    "check:no-effect": "bun scripts/check-no-effect.mts",
    "check:no-legacy-imports": "bun scripts/check-no-legacy-imports.mts",
    "check:no-node-runtime": "bun scripts/check-no-node-runtime.mts",
    "check:plugin-graph": "bun scripts/check-plugin-graph.mts",
    "check:vendor-locks": "bun scripts/check-vendor-locks.mts",
    "check:baseline": "bun scripts/check-baseline.mts",
    "check:runtimes": "bun scripts/check-runtime-builds.mts",
    "check:parity": "bun scripts/check-parity.mts",
    "check:parity:strict": "bun scripts/check-parity.mts --strict",
    "check:core-parity": "bun scripts/check-core-parity.mts",
    "check:ui-parity": "bun scripts/check-ui-parity.mts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:4.0.1",
    "@deepseek-ai/cordis-plugin-group": "workspace:1.0.1",
    "@deepseek-ai/cordis-plugin-loader": "workspace:1.0.2",
    "@deepseek-ai/cosmokit": "workspace:1.8.2",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.0",
    "@standard-schema/spec": "1.1.0",
    "drizzle-orm": "1.0.0-rc.2",
    "hono": "4.13.2",
    "openapi-fetch": "0.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/bun": "1.3.11",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.43.0",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.17",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
