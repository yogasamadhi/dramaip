{
  "name": "@dramaip/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DramaIP Studio Next plugin-first desktop application",
  "author": "sdns",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun --bun run electron-vite dev",
    "build": "bun --bun run electron-vite build",
    "build:codex": "node scripts/prepare-codex-runtime.mjs",
    "build:dsh": "node scripts/prepare-dsh-runtime.mjs",
    "build:pi": "node scripts/prepare-pi-runtime.mjs",
    "build:opencode": "node scripts/prepare-opencode-runtime.mjs",
    "preview": "bun --bun run electron-vite preview",
    "package": "bun run build:opencode && bun run build:codex && bun run build:dsh && bun run verify:dsh && bun run build:pi && bun run verify:pi && bun run --cwd ../.. check:runtimes && bun run build && node scripts/package-app.mjs",
    "test:e2e": "bunx playwright test tests/electron --reporter=list",
    "verify:dsh": "node scripts/verify-dsh-runtime.mjs",
    "verify:pi": "node scripts/verify-pi-runtime.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.82",
    "@ai-sdk/google": "3.0.73",
    "@ai-sdk/openai": "3.0.84",
    "@ai-sdk/openai-compatible": "2.0.56",
    "@dramaip/agents": "workspace:*",
    "@dramaip/client": "workspace:*",
    "@dramaip/contracts": "workspace:*",
    "@dramaip/kernel": "workspace:*",
    "@dramaip/runtime": "workspace:*",
    "@dramaip/ui": "workspace:*",
    "@dramaip/ui-catalog": "workspace:*",
    "@dramaip/ui-shared": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@langchain/langgraph": "0.2.43",
    "ai": "6.0.168",
    "lucide-react": "0.454.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@openai/codex": "0.147.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.2.0",
    "electron-builder": "26.11.1",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  }
}
