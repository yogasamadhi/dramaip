# ============================================================================
# Root .gitignore — applies across the whole dramaip monorepo.
# Sub-projects (dramaip-platform/, dramaip-desktop/) have their own .gitignore
# for specifics; this file is the cross-cutting default so common artifacts are
# never accidentally committed at any level.
# ============================================================================

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.fleet/
.history/
*.iml
*.swp
*.swo
*~

# ---- Secrets / environment ----
.env
.env.*
!.env.example
!.env.*.example
.envrc
.direnv/

# ---- Python (root run-*.py launchers + any tooling) ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
.python-version

# ---- Node.js / pnpm (monorepo-wide) ----
node_modules/
.pnpm-store/
.npm/
.pnp
.pnp.*
.turbo/
.nx/
.eslintcache
.stylelintcache
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- TypeScript / JS build output ----
*.tsbuildinfo
dist/
out/
.next/
.nuxt/
.expo/
.expo-shared/
.parcel-cache/
.cache/
.vite/
dist-electron/

# `release/`, `build/` and `artifacts/` are intentionally not ignored here:
# this repository tracks release docs, deployment scripts and Electron metadata
# under directories with those names. Sub-project rules scope generated output.

# ---- Go (services build output) ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
*.coverprofile
coverage.out
services/bin/
services/tmp/

# ---- Java / Maven generated output ----
target/
.flattened-pom.xml
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.mvn/timing.properties
hs_err_pid*
replay_pid*

# ---- Logs & runtime artifacts ----
*.log
*.log.*
*.pid
*.pid.lock
logs/
_tmp_*
tmp/
temp/

# ---- Test / coverage ----
coverage/
.nyc_output/
.trivy/
trivy-reports/
.scannerwork/
test-results/
playwright-report/
blob-report/

# ---- Local databases & generated data ----
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql.bak
.data/

# ---- Local agent / tool state ----
.zcode/
