# Dependencies
node_modules/
**/node_modules/
.pnp.*
.pnpm-store/

# Build output
dist/
**/dist/
out/
**/out/
dist-electron/
release/
**/release/
*.tsbuildinfo

# Electron / Vite caches
.cache/
**/.cache/
.vite/
**/.vite/
node_modules/.cache/
**/node_modules/.cache/

# Test and coverage output
coverage/
**/coverage/
.nyc_output/

# Database and generated local data
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql.bak

# Keep generated SQL migrations commit-friendly.
!packages/db/drizzle/**/*.sql

# Logs and runtime artifacts
*.log
logs/
**/logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
_tmp_*
tmp/
temp/

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# OS and editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Package artifacts
*.tgz
*.zip
*.dmg
*.AppImage
*.deb
*.rpm
