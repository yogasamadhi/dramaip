# ============================================================================
# Root .gitignore — applies across the whole dramaip monorepo.
# Sub-projects (dramaip-platform/, dramaip-desktop/) have their own .gitignore
# for specifics; this file is the cross-cutting default so common artifacts are
# never accidentally committed at any level.
# ============================================================================

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- Secrets / environment ----
.env
.env.*
!.env.example
!.env.*.example

# ---- Python (root run-*.py launchers + any tooling) ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.python-version

# ---- Node.js / pnpm (monorepo-wide) ----
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- TypeScript / JS build output ----
*.tsbuildinfo
dist/
out/
.next/
.nuxt/
.expo/
.parcel-cache/
.cache/
.vite/

# ---- Go (services build output) ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
services/bin/
services/tmp/

# ---- Logs & runtime artifacts ----
*.log
logs/
_tmp_*
tmp/
temp/

# ---- Test / coverage ----
coverage/
.nyc_output/

# ---- Local databases & generated data ----
*.db
*.db-*
*.sqlite
*.sqlite3
.data/
