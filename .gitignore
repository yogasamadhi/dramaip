# ============================================================================
# Root .gitignore — applies across the whole dramaip monorepo.
# Sub-projects (platform/, desktop/) have their own .gitignore
# for specifics; this file is the cross-cutting default so common artifacts are
# never accidentally committed at any level.
# ============================================================================

# ---- OS files ----
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Editor / IDE / merge artifacts ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode-test/
.idea/
.fleet/
.history/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
*.orig
*.rej

# ---- Secrets / environment ----
.env
.env.*
!.env.example
!.env.*.example
.envrc
.direnv/

# ---- Python (root run-*.py launchers + any tooling) ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
.python-version

# Do not ignore a bare `env/` directory: source trees may legitimately use it
# (for example desktop/vendor/opencode/packages/opencode/src/env/).

# ---- Node.js / Bun (monorepo-wide) ----
node_modules/
# Local package-manager stores (developer cache only).
.pnpm-store/
.npm/
.pnp
.pnp.*
.turbo/
.nx/
.eslintcache
.stylelintcache

# ---- TypeScript / JS build output ----
*.tsbuildinfo
dist/
out/
.next/
.nuxt/
.expo/
.expo-shared/
.parcel-cache/
.cache/
.vite/
dist-electron/
storybook-static/

# `release/`, `build/` and `artifacts/` are intentionally not ignored here:
# this repository tracks release docs, deployment scripts and Electron metadata
# under directories with those names. Sub-project rules scope generated output.

# ---- Java / Maven generated output ----
target/
*.class
.flattened-pom.xml
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.mvn/timing.properties
hs_err_pid*
replay_pid*
*.hprof
.attach_pid*

# ---- Logs & runtime artifacts ----
*.log
*.log.*
*.pid
*.pid.lock
logs/
.run-logs/
_tmp_*
tmp/
temp/

# ---- Test / coverage ----
coverage/
.nyc_output/
.trivy/
trivy-reports/
.scannerwork/
test-results/
playwright-report/
blob-report/

# ---- Local databases & generated data ----
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql.bak
.data/

# ---- Local agent / tool state ----
.zcode/
