# npm-compatible registry configuration for the DramaIP Desktop workspace.
#
# pnpm 11 reads `nodeLinker` from `pnpm-workspace.yaml`; keep this file for
# registry, mirror and network settings only.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
