# DramaIP Services 环境变量样例（Go / Kratos monorepo）
#
# 本地开发：复制为 services/.env。
# docker compose / run-platform.py 会显式加载 services/.env；宿主机 go run
# 也会从当前目录向上寻找 services/.env 并加载。
# 已经 export 的 shell/CI 环境变量优先，不会被 .env 覆盖。
# 注意：docker-compose.yaml 会覆盖容器内网络地址（postgres/auth/...），
# 所以这里的 localhost 地址用于宿主机单服务调试。
# 生产环境必须替换所有 changeme / replace-me / __FILL_IN_PROD__。

# ========== 运行环境 ==========
# dev | staging | prod
ENV=dev
# debug | info | warn | error
LOG_LEVEL=debug
TIMEZONE=Asia/Shanghai

# ========== PostgreSQL（权威库，每服务独立 schema）==========
# 与 deploy/docker-drama/docker-compose.yaml 的 postgres 服务对齐。
# POSTGRES_USER/PASSWORD 是仅供 migration job 使用的 DDL 身份；不要把它们
# 注入常规服务。每个服务通过下面对应的 runtime role 连接自己的 schema。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dramaip
POSTGRES_PASSWORD=dramaip
POSTGRES_DB=dramaip
POSTGRES_SSLMODE=disable
# POSTGRES_DSN 如启用，必须使用 URL 形式，便于服务安全覆盖为自己的登录角色：
# POSTGRES_DSN=postgres://dramaip:dramaip@localhost:5432/dramaip?sslmode=disable
# migration 会在首次运行时创建/轮换以下运行角色；生产中可由 DB 管理员
# 预创建角色后设置 DB_ROLE_BOOTSTRAP=false。每项必须使用不同的生产密码。
DB_ROLE_BOOTSTRAP=true
POSTGRES_AUTH_PASSWORD=dramaip
POSTGRES_USER_PROFILE_PASSWORD=dramaip
POSTGRES_BILLING_PASSWORD=dramaip
POSTGRES_QUOTA_PASSWORD=dramaip
POSTGRES_AI_GATEWAY_PASSWORD=dramaip
POSTGRES_NOTIFICATION_PASSWORD=dramaip

# ========== Redis（缓存 / 限流 / 验证码，非可信源）==========
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=dramaip
REDIS_DB=0

# ========== RabbitMQ（异步事件 / outbox relay 投递）==========
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dramaip
RABBITMQ_PASSWORD=dramaip
RABBITMQ_VHOST=/
# Optional full AMQP URL override.
# RABBITMQ_URL=amqp://dramaip:dramaip@localhost:5672/
# Versioned domain events are published to this durable topic exchange. Each
# consumer binds its own queue, so notification delivery never competes with
# billing/quota consumers for the same message.
RABBITMQ_EXCHANGE=dramaip.platform.events
# Legacy default-exchange fallback only; topic consumers configure their own
# queues (for example NOTIFICATION_EVENTS_QUEUE below).
RABBITMQ_EVENTS_QUEUE=dramaip.platform.events

# ========== 认证 / JWT（auth-service）==========
# access token 固定使用 RS256。dev 允许以下三个路径留空并生成进程内临时密钥；
# prod/production 必须从受控挂载提供 private.pem 与 jwks.json，绝不提交私钥。
# jwks.json 必须包含当前 key 与轮换窗口内的保留公钥；JWT_ACTIVE_KID 对应 private.pem。
JWT_ISSUER=dramaip
JWT_AUDIENCE=dramaip-api
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY_FILE=
JWT_JWKS_FILE=
# 单位：秒
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# 生产建议 12 以上
BCRYPT_COST=10

# ========== 服务端口（HTTP / gRPC）==========
# BFF 仅绑 loopback（127.0.0.1:8100）；对外入口为 Kong :8000，upstream 见 deploy/kong/kong.yml。
# 端口号与 deploy/docker-drama/docker-compose.yaml 保持一致。
AUTH_HTTP_ADDR=:8101
AUTH_GRPC_ADDR=:9101
USER_HTTP_ADDR=:8102
USER_GRPC_ADDR=:9102
BILLING_HTTP_ADDR=:8103
BILLING_GRPC_ADDR=:9103
QUOTA_HTTP_ADDR=:8104
QUOTA_GRPC_ADDR=:9104
AI_GATEWAY_HTTP_ADDR=:8105
AI_GATEWAY_GRPC_ADDR=:9105
NOTIFICATION_HTTP_ADDR=:8108
NOTIFICATION_GRPC_ADDR=:9106
NOTIFICATION_JOB_HTTP_ADDR=:8109
WEB_BFF_HTTP_ADDR=127.0.0.1:8100
# Web BFF 将 access/refresh 放在 HttpOnly Cookie；prod 会强制 Secure。
WEB_REFRESH_COOKIE_TTL=720h
# 同源部署保持为空。app.example.com -> api.example.com 时，只能使用受控父域 example.com。
WEB_COOKIE_DOMAIN=

# Production gRPC requires mTLS. Local Compose remains explicitly plaintext;
# production must provide CA-issued per-service certificate/key file mounts.
GRPC_MTLS_ENABLED=false
GRPC_MTLS_CERT_FILE=
GRPC_MTLS_KEY_FILE=
GRPC_MTLS_CA_FILE=
# 常规服务绝不执行 DDL；使用 migration/job（或 Compose 的 migrate 服务）。
AUTO_MIGRATE=false
MIGRATIONS_DIR=./migrations

# 内部服务间 gRPC 直连地址（不经 Kong）。
# BFF / ai-gateway 用这些拨下游；生产用 K8s DNS / 服务发现覆盖，
# 例如 auth-service.dramaip.svc.cluster.local:9101。
AUTH_GRPC_ENDPOINT=localhost:9101
USER_GRPC_ENDPOINT=localhost:9102
BILLING_GRPC_ENDPOINT=localhost:9103
QUOTA_GRPC_ENDPOINT=localhost:9104
AI_GATEWAY_GRPC_ENDPOINT=localhost:9105
NOTIFICATION_GRPC_ENDPOINT=localhost:9106

# ========== Kong 网关 ==========
# 外部入口 / 管理面（与 docker-compose 的 kong 服务对齐）。
KONG_PROXY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001

# ========== 支付（billing-service）==========
# Dev/test only: the simulated provider exposes
# POST /billing/payments/simulated/confirm when ENV is dev or test.
# Production payment state must come from verified provider webhooks.
BILLING_SIMULATED_ENABLED=true
# 支付回调外部可达地址由 Kong 路由到 billing-service。
# 微信支付 V3
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=__FILL_IN_PROD__
WECHAT_PAY_MCH_ID=__FILL_IN_PROD__
WECHAT_PAY_API_V3_KEY=__FILL_IN_PROD__
WECHAT_PAY_CERT_SERIAL=__FILL_IN_PROD__
WECHAT_PAY_PRIVATE_KEY_PATH=./configs/wechat_apiclient_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=./configs/wechat_platform_cert.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/webhooks/wechat-pay
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
# 支付宝
ALIPAY_APP_ID=__FILL_IN_PROD__
ALIPAY_PRIVATE_KEY_PATH=./configs/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=./configs/alipay_alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://api.example.com/webhooks/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ========== AI 网关（ai-gateway-service）==========
# OpenAI-compatible 上游。生产用平台自有账号，密钥绝不下发到桌面端 / 客户端。
AI_PROVIDER_DEFAULT=openai-compatible
AI_PROVIDERS=openai-compatible
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=sk-replace-me
AI_DEFAULT_MODEL=gpt-4o-mini
# dev/test 默认启用本地 test provider，供 CI/e2e 走完整额度扣减链路。
AI_TEST_PROVIDER_ENABLED=true
# 非 test provider 必须按 provider/model 配置每百万 input/output token 的价格快照；
# 价格或汇率缺失时 ai-gateway 在调用上游前保守拒绝。
AI_PROVIDER_OPENAI_COMPATIBLE_GPT_4O_MINI_INPUT_PRICE_PER_MILLION=
AI_PROVIDER_OPENAI_COMPATIBLE_GPT_4O_MINI_OUTPUT_PRICE_PER_MILLION=
AI_PROVIDER_OPENAI_COMPATIBLE_GPT_4O_MINI_CURRENCY=USD
AI_PROVIDER_OPENAI_COMPATIBLE_GPT_4O_MINI_EXCHANGE_RATE_TO_CNY=
# 平台成本风控（CNY）：已记录成本 + 未完成请求的保守预估共同计入窗口。
AI_COST_WINDOW=5m
AI_USER_COST_LIMIT_CNY=5
AI_IP_COST_LIMIT_CNY=20
AI_REQUEST_COST_ALERT_CNY=1
# AI 请求频率与日 token 保护（与 quota 预扣租约配合）。
AI_USER_RPM_LIMIT=60
AI_USER_DAILY_TOKEN_LIMIT=2000000

# ========== Outbox relay（见 docs/技术架构.md §5.7 / §11）==========
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# 每个 billing-job 实例对 outbox 行的租约与失败重试退避。
OUTBOX_LEASE=30s
OUTBOX_RETRY_DELAY=5s

# ========== Notification event consumer ==========
NOTIFICATION_EVENTS_QUEUE=dramaip.notification.events
NOTIFICATION_DLQ_EXCHANGE=dramaip.platform.events.dlx
NOTIFICATION_DLQ_QUEUE=dramaip.notification.events.dlq
NOTIFICATION_EVENT_PREFETCH=1
NOTIFICATION_EVENT_MAX_RETRIES=3
NOTIFICATION_INBOX_LEASE=1m
# Comma-separated adapters. Only durable in-app delivery is enabled by default;
# email/SMS adapters must be explicitly implemented before being configured.
NOTIFICATION_CHANNELS=in_app

# ========== 可观测性 ==========
# OpenTelemetry 导出（OTLP/HTTP，端口 4318）。docker compose 容器内通过服务名
# otel-collector 访问采集器；宿主机直接 go run 单服务时改回 http://localhost:4318。
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=dramaip-web-bff
OTEL_EXPORTER_OTLP_INSECURE=true
# Sentry：按 service 分流，生产各服务独立 DSN 更佳。
SENTRY_DSN=
# Prometheus 由各服务 /metrics 端点暴露，通常无需 env。
