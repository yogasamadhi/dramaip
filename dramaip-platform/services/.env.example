# DramaIP Services 环境变量样例（Go / Kratos monorepo）
#
# 本地开发：复制为 services/.env，或由 docker-compose 注入容器。
# 各服务在自己的 configs/config.yaml 里通过 ${VAR} 引用这些值（Kratos env 替换）。
# 生产环境必须替换所有 changeme / replace-me / __FILL_IN_PROD__。

# ========== 运行环境 ==========
# dev | staging | prod
ENV=dev
# debug | info | warn | error
LOG_LEVEL=debug
TIMEZONE=Asia/Shanghai

# ========== PostgreSQL（权威库，每服务独立 schema）==========
# 与 deploy/docker/docker-compose.yaml 的 postgres 服务对齐。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dramaip
POSTGRES_PASSWORD=dramaip
POSTGRES_DB=dramaip
POSTGRES_SSLMODE=disable
# 组合 DSN（GORM / Kratos 惯例），如需可直接用：
# POSTGRES_DSN=host=localhost user=dramaip password=dramaip dbname=dramaip port=5432 sslmode=disable TimeZone=Asia/Shanghai
# 各服务在 config.yaml 中指定自己的 schema（auth / user / billing / quota），共享同一实例。

# ========== Redis（缓存 / 限流 / 验证码，非可信源）==========
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=dramaip
REDIS_DB=0

# ========== RabbitMQ（异步事件 / outbox relay 投递）==========
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dramaip
RABBITMQ_PASSWORD=dramaip
RABBITMQ_VHOST=/

# ========== 认证 / JWT（auth-service）==========
# 生产必须替换为强随机值（>=32 字节）；access 与 refresh 用不同 secret。
JWT_ACCESS_SECRET=changeme-access-secret-replace-in-prod
JWT_REFRESH_SECRET=changeme-refresh-secret-replace-in-prod
# 单位：秒
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=dramaip
# 生产建议 12 以上
BCRYPT_COST=10

# ========== 服务端口（HTTP / gRPC）==========
# BFF 仅绑 loopback（127.0.0.1:8100）；对外入口为 Kong :8000，upstream 见 deploy/kong/kong.yml。
AUTH_HTTP_ADDR=:8200
AUTH_GRPC_ADDR=:8201
USER_HTTP_ADDR=:8300
USER_GRPC_ADDR=:8301
BILLING_HTTP_ADDR=:8400
BILLING_GRPC_ADDR=:8401
QUOTA_HTTP_ADDR=:8500
QUOTA_GRPC_ADDR=:8501
AI_GATEWAY_HTTP_ADDR=:8600
AI_GATEWAY_GRPC_ADDR=:8601
BFF_HTTP_ADDR=127.0.0.1:8100
BFF_GRPC_ADDR=:8101

# 内部服务间 gRPC 直连地址（不经 Kong）。
# BFF / ai-gateway 用这些拨下游；生产用 K8s DNS / 服务发现覆盖，
# 例如 auth.default.svc.cluster.local:8201。
AUTH_GRPC_ENDPOINT=localhost:8201
USER_GRPC_ENDPOINT=localhost:8301
BILLING_GRPC_ENDPOINT=localhost:8401
QUOTA_GRPC_ENDPOINT=localhost:8501
AI_GATEWAY_GRPC_ENDPOINT=localhost:8601

# ========== Kong 网关 ==========
# 外部入口 / 管理面（与 docker-compose 的 kong 服务对齐）。
KONG_PROXY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001

# ========== 支付（billing-service）==========
# 支付回调外部可达地址由 Kong 路由到 billing-service。
# 微信支付 V3
WECHAT_PAY_APP_ID=__FILL_IN_PROD__
WECHAT_PAY_MCH_ID=__FILL_IN_PROD__
WECHAT_PAY_API_V3_KEY=__FILL_IN_PROD__
WECHAT_PAY_CERT_SERIAL=__FILL_IN_PROD__
WECHAT_PAY_PRIVATE_KEY_PATH=./configs/wechat_apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/webhooks/wechat-pay
# 支付宝
ALIPAY_APP_ID=__FILL_IN_PROD__
ALIPAY_PRIVATE_KEY_PATH=./configs/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=./configs/alipay_alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://api.example.com/webhooks/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ========== AI 网关（ai-gateway-service）==========
# OpenAI-compatible 上游。生产用平台自有账号，密钥绝不下发到桌面端 / 客户端。
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=sk-replace-me
AI_DEFAULT_MODEL=gpt-4o-mini
# 单用户成本风控（与 quota 预扣租约配合）。
AI_USER_RPM_LIMIT=60
AI_USER_DAILY_COST_LIMIT=2.0

# ========== Outbox relay（见 docs/技术架构.md §5.7 / §11）==========
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# ========== 可观测性 ==========
# OpenTelemetry 导出（OTLP gRPC），本地发往 docker-drama 的 otel-collector。
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Sentry：按 service 分流，生产各服务独立 DSN 更佳。
SENTRY_DSN=
# Prometheus 由各服务 /metrics 端点暴露，通常无需 env。
