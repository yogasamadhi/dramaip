ARG GO_IMAGE=golang:1.24-alpine
ARG RUNTIME_IMAGE=alpine:3.20

FROM ${GO_IMAGE} AS build

ARG TARGET=./app/bff/web/interface/cmd/server
ARG OUTPUT=dramaip-service
ARG GOPROXY=https://proxy.golang.org,direct
ARG GOMAXPROCS=

WORKDIR /src
COPY go.mod go.sum ./
# GOPROXY is a build-time setting only. Operators on controlled networks can
# supply a reachable, approved proxy without changing the final runtime image.
RUN --mount=type=cache,id=dramaip-go-mod,target=/go/pkg/mod,sharing=locked \
    GOPROXY="${GOPROXY}" go mod download

ARG BUILD_CACHE_BUST=dev
RUN echo "${BUILD_CACHE_BUST}" > /tmp/dramaip-build-cache-bust

COPY . .
RUN --mount=type=cache,id=dramaip-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=dramaip-go-build,target=/root/.cache/go-build,sharing=locked \
    if [ -n "${GOMAXPROCS}" ]; then export GOMAXPROCS; fi; \
    CGO_ENABLED=0 GOOS=linux go build -o /out/${OUTPUT} ${TARGET}

FROM ${RUNTIME_IMAGE}

ARG OUTPUT=dramaip-service

WORKDIR /app
COPY --from=build /out/${OUTPUT} /app/dramaip-service
COPY migrations /app/migrations

EXPOSE 8100 8101 8102 8103 8104 8105 8106 8107 8108 8109 8110 8111 8112 8113 8120 8130 9101 9102 9103 9104 9105 9106 9107 9108
CMD ["/app/dramaip-service"]
