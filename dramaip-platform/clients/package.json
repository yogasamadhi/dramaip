{
  "name": "dramaip-platform-clients",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev:web": "pnpm --filter @dramaip/web dev",
    "build:web": "pnpm --filter @dramaip/web build",
    "dev:admin": "pnpm --filter @dramaip/admin dev",
    "build:admin": "pnpm --filter @dramaip/admin build",
    "dev:mobile": "pnpm --filter @dramaip/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
