{
  "name": "dramaip-platform-clients",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @dramaip/web dev",
    "build:web": "bun run --filter @dramaip/web build",
    "dev:admin": "bun run --filter @dramaip/admin dev",
    "build:admin": "bun run --filter @dramaip/admin build",
    "dev:mobile": "bun run --filter @dramaip/mobile start",
    "contracts:check": "bun run scripts/check-client-contracts.mjs",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "lint": "bun run --workspaces --sequential lint",
    "test": "bun run --filter @dramaip/sdk test && bun run --filter @dramaip/web test && bun run --filter @dramaip/admin test && bun run --filter @dramaip/mobile test:security"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  }
}
