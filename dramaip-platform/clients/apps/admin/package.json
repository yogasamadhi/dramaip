{
  "name": "@dramaip/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun run vite --host 0.0.0.0 --port 3010",
    "build": "bun run typecheck && bun --bun run vite build",
    "preview": "bun --bun run vite preview --host 0.0.0.0 --port 4010",
    "typecheck": "bun --bun run tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test tests/*.test.mjs"
  },
  "dependencies": {
    "@dramaip/sdk": "workspace:*",
    "echarts": "^5.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
