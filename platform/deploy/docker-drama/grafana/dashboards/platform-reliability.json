{
  "uid": "dramaip-platform-reliability",
  "title": "DramaIP Platform Reliability",
  "schemaVersion": 41,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Request rate", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service) (rate(dramaip_requests_total[5m]))" }], "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 } },
    { "id": 2, "type": "timeseries", "title": "Request error ratio", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service) (rate(dramaip_requests_total{outcome=\"error\"}[5m])) / sum by (service) (rate(dramaip_requests_total[5m]))" }], "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }, "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 } },
    { "id": 3, "type": "timeseries", "title": "Payment confirmations", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service, outcome) (increase(dramaip_business_events_total{event=\"payment_confirmation\"}[5m]))" }], "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 } },
    { "id": 4, "type": "timeseries", "title": "Quota reservations", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service, outcome) (increase(dramaip_quota_reservations_total[5m]))" }], "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 } },
    { "id": 5, "type": "timeseries", "title": "Billing outbox backlog", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "dramaip_outbox_pending_events" }], "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 } },
    { "id": 6, "type": "timeseries", "title": "Provider latency and failures", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service, provider, outcome) (rate(dramaip_provider_requests_total[5m]))" }, { "refId": "B", "expr": "sum by (service, provider) (rate(dramaip_provider_request_duration_seconds_sum[5m])) / sum by (service, provider) (rate(dramaip_provider_request_duration_seconds_count[5m]))" }], "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 } },
    { "id": 7, "type": "timeseries", "title": "Provider cost alerts", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service, event) (increase(dramaip_provider_cost_alerts_total[5m]))" }], "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 } },
    { "id": 8, "type": "timeseries", "title": "p95 request latency", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(dramaip_request_duration_seconds_bucket[5m])))" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 } },
    { "id": 9, "type": "timeseries", "title": "RabbitMQ ready-message backlog", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (queue) (rabbitmq_queue_messages_ready)" }], "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 } },
    { "id": 10, "type": "timeseries", "title": "Aggregated errors by class", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service, class, operation) (increase(dramaip_errors_total[5m]))" }], "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 } },
    { "id": 11, "type": "timeseries", "title": "Database pool utilization", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "100 * sum by (service) (dramaip_db_connections{state=\"in_use\"}) / clamp_min(sum by (service) (dramaip_db_max_open_connections), 1)" }], "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }, "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 } },
    { "id": 12, "type": "timeseries", "title": "Database wait count", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "dramaip_db_wait_count" }], "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 } },
    { "id": 14, "type": "timeseries", "title": "Telemetry write and discard events", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[5m]))", "legendFormat": "Alloy trace export failures" }, { "refId": "B", "expr": "sum(rate(loki_write_dropped_entries_total[5m]))", "legendFormat": "Alloy log drops" }, { "refId": "C", "expr": "sum(rate(loki_discarded_samples_total[5m]))", "legendFormat": "Loki discarded logs" }, { "refId": "D", "expr": "sum(rate(tempo_discarded_spans_total[5m]))", "legendFormat": "Tempo discarded spans" }, { "refId": "E", "expr": "sum(rate(loki_ingester_wal_disk_full_failures_total[5m]))", "legendFormat": "Loki WAL write failures" }, { "refId": "F", "expr": "sum(rate(loki_ingester_wal_corruptions_total[5m]))", "legendFormat": "Loki WAL corruptions" }, { "refId": "G", "expr": "sum(rate(loki_process_dropped_lines_total{reason=\"sensitive_content\"}[5m]))", "legendFormat": "Sensitive logs rejected" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "gridPos": { "x": 0, "y": 40, "w": 24, "h": 8 } },
    { "id": 15, "type": "timeseries", "title": "Trace delivery flow", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_exporter_sent_spans_total[5m]))", "legendFormat": "Alloy exported" }, { "refId": "B", "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))", "legendFormat": "Tempo received" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "gridPos": { "x": 0, "y": 48, "w": 12, "h": 8 } },
    { "id": 16, "type": "timeseries", "title": "Log delivery flow", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum(rate(loki_write_sent_entries_total[5m]))", "legendFormat": "Alloy sent" }, { "refId": "B", "expr": "sum(rate(loki_write_batch_retries_total[5m]))", "legendFormat": "Alloy retries" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "gridPos": { "x": 12, "y": 48, "w": 12, "h": 8 } },
    { "id": 17, "type": "timeseries", "title": "Alloy trace exporter queue utilization", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum(otelcol_exporter_queue_size) / clamp_min(sum(otelcol_exporter_queue_capacity), 1)", "legendFormat": "Queue utilization" }], "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }, "gridPos": { "x": 0, "y": 56, "w": 12, "h": 8 } },
    { "id": 18, "type": "timeseries", "title": "Loki WAL disk usage", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "max(loki_ingester_wal_disk_usage_percent)", "legendFormat": "WAL filesystem" }], "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }, "gridPos": { "x": 12, "y": 56, "w": 12, "h": 8 } },
    { "id": 19, "type": "timeseries", "title": "Async workflow outcomes", "datasource": { "type": "prometheus", "uid": "dramaip-prometheus" }, "targets": [{ "refId": "A", "expr": "sum by (service, workflow, outcome) (rate(dramaip_workflow_events_total[5m]))", "legendFormat": "{{service}} / {{workflow}} / {{outcome}}" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "gridPos": { "x": 0, "y": 64, "w": 24, "h": 8 } },
    { "id": 13, "type": "logs", "title": "Recent warning and error logs by service", "datasource": { "type": "loki", "uid": "dramaip-loki" }, "targets": [{ "refId": "A", "expr": "{service_name=~\".+\"} | json | level=~\"(?i)(warn|error)\"", "queryType": "range" }], "options": { "showTime": true, "showLabels": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }, "gridPos": { "x": 0, "y": 72, "w": 24, "h": 10 } }
  ]
}
