# DramaIP Clients 环境变量样例（TypeScript workspace）
#
# 这是 workspace 级参考。各 app 复制自己需要的项到对应文件：
#   Web:    clients/apps/web/.env.local      （Next.js 读取）
#   Mobile: clients/apps/mobile/.env         （Expo 读取；或写进 app.json 的 "env"）
#
# 只有带 NEXT_PUBLIC_ / EXPO_PUBLIC_ 前缀的变量会暴露给客户端运行时。
# 本地默认直连 Java Gateway（http://localhost:8080）。

# ========== Web（Next.js，前缀 NEXT_PUBLIC_）==========

# 后端 API 入口
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 站点地址：SEO canonical、OAuth 回调、邮件链接基址
NEXT_PUBLIC_SITE_URL=http://localhost:3009

# 前端错误上报（可选，留空不上报）
NEXT_PUBLIC_SENTRY_DSN=

# ========== Mobile（Expo，前缀 EXPO_PUBLIC_）==========

EXPO_PUBLIC_MOBILE_API_ORIGIN=http://localhost:8080

# 真机调试时需用局域网 IP 才能访问本地后端，例如：
# EXPO_PUBLIC_MOBILE_API_ORIGIN=http://192.168.1.10:8080

EXPO_PUBLIC_SENTRY_DSN=

# ========== 安全红线 ==========
# 客户端绝不持有任何密钥（API Key、平台 secret、支付私钥、JWT 签名密钥）。
# 所有需要密钥的调用都必须经后端 Java 服务完成（见 docs/后端技术架构.md）。
