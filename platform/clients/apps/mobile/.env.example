# Mobile (Expo) environment sample.
# Copy to `.env` (Expo reads it automatically) and adjust for your machine.
# Only EXPO_PUBLIC_ prefixed values are exposed to the client bundle.
# On a physical device, use your machine's LAN IP so Expo Go can reach the backend.

# Java Gateway API origin. Defaults to http://localhost:8080 via the launcher.
EXPO_PUBLIC_MOBILE_API_ORIGIN=http://localhost:8080

# Optional: legacy alias kept in sync with EXPO_PUBLIC_MOBILE_API_ORIGIN.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional client-side error reporting (leave empty to disable).
EXPO_PUBLIC_SENTRY_DSN=

# ========== Security red line ==========
# The client never holds secrets (API keys, platform secrets, payment private
# keys, JWT signing keys). All secret-bearing calls must run through the Java
# backend (see docs/后端技术架构.md).
