# npm-compatible registry configuration for the DramaIP Platform clients.
#
# Metro/Babel (Expo) resolve plugins by *name string* via Node's classic
# upward module resolution, which requires transitive deps to be hoisted to
# the project root. pnpm's default isolated linker leaves them only in the
# virtual store and breaks that lookup ("Cannot find module
# '@babel/plugin-transform-react-jsx'").
node-linker=hoisted
