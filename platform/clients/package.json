{
  "name": "dramaip-platform-clients",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev:web": "pnpm --filter @dramaip/web run dev",
    "build:web": "pnpm --filter @dramaip/web run build",
    "dev:admin": "pnpm --filter @dramaip/admin run dev",
    "build:admin": "pnpm --filter @dramaip/admin run build",
    "dev:mobile": "pnpm --filter @dramaip/mobile run start",
    "contracts:check": "node scripts/check-client-contracts.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && pnpm run typecheck:launchers",
    "typecheck:launchers": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --types node ../../run-platform-clients.ts ../../run-platform-dev.ts",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "test": "pnpm --filter @dramaip/sdk run test && pnpm --filter @dramaip/web run test && pnpm --filter @dramaip/admin run test && pnpm --filter @dramaip/mobile run test:security && pnpm run test:launchers",
    "test:launchers": "vitest run scripts/platform-launchers.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "11.28.5"
  }
}
