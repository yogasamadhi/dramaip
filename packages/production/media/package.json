{
  "name": "@dramaip/production-media",
  "description": "Host face of the media domain: assets, generation, shot stills, renders, episode media, media sources, byte verifications, playback, audio revisions, likeness subjects, rights and delivery evidence",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./legacy": "./src/legacy.ts",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./playback-content": "./src/playback-content.ts",
    "./handlers/media": "./handlers/media/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "handlers"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@dramaip/contracts": "workspace:*",
    "@dramaip/host-contracts": "workspace:*",
    "@dramaip/infra-connection": "workspace:*",
    "@dramaip/infra-operations": "workspace:*",
    "@dramaip/infra-typert-protocol": "workspace:*",
    "@dramaip/infra-values": "workspace:*",
    "@dramaip/infra-webserver": "workspace:*",
    "@dramaip/plugin-api": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-typert-registry": "workspace:*"
  }
}
