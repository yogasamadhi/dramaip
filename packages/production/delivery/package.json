{
  "name": "@dramaip/production-delivery",
  "description": "Host face of the delivery domain: delivery records, localization, manuscripts, pilot packages and platform delivery",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./legacy": "./src/legacy.ts",
