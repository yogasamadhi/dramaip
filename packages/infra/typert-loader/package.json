{
  "name": "@dramaip/infra-typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@dramaip/infra-typert-registry": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@dramaip/infra-app-boot": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@dramaip/infra-typert-registry": "workspace:*",
    "@dramaip/infra-typert-protocol": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  },
  "dramaip": {
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/typert/loader",
      "package": "@deepseek-ai/dsh-typert-loader",
      "version": "0.2.1-rc.3"
    }
  }
}
