    "@dramaip/infra-launch-environment": "workspace:*",
    "@dramaip/infra-home-paths": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/semver": "^7.8.0",
    "@deepseek-ai/cordis": "workspace:*"
