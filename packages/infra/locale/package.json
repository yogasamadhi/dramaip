{
  "name": "@dramaip/infra-locale",
  "description": "Locale plugin: Host-backed preference, extensible language catalog, browser fallback, and typed built-in dictionaries",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-remotes": "workspace:*",
    "@dramaip/infra-client-store": "workspace:*",
    "@dramaip/infra-ui-primitives": "workspace:*",
    "@dramaip/infra-ui-renderer": "workspace:*",
    "@dramaip/infra-ui-settings": "workspace:*",
    "@dramaip/infra-ui-slots": "workspace:*",
    "@dramaip/infra-package-manifest": "workspace:*",
    "react": "^18.2.0",
    "@dramaip/infra-connection": "workspace:*",
    "@dramaip/infra-settings": "workspace:*",
    "@dramaip/infra-test-runtime": "workspace:*"
  },
  "dramaip": {
    "client": {
      "inject": [
        "@dramaip/infra-connection",
        "@dramaip/infra-ui-renderer",
        "@dramaip/infra-ui-settings",
        "@dramaip/infra-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/client/locale",
      "package": "@deepseek-ai/dsh-client-locale",
      "version": "0.2.1-rc.3"
    }
  }
}
