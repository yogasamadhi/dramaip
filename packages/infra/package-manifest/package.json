{
  "name": "@dramaip/infra-package-manifest",
  "description": "Shared type declarations for package.json dramaip configuration fields",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dramaip": {
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/util/package-manifest",
      "package": "@deepseek-ai/dsh-package-manifest",
      "version": "0.2.1-rc.3"
    }
  }
}
