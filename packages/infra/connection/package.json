{
  "name": "@dramaip/infra-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-scope": "workspace:*"
  },
  "dependencies": {
    "@dramaip/infra-credentials": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-brand": "workspace:*",
    "@dramaip/infra-webserver": "workspace:*",
    "@dramaip/infra-scope": "workspace:*",
    "@dramaip/infra-typert-protocol": "workspace:*"
  },
  "dramaip": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/client/connection",
      "package": "@deepseek-ai/dsh-client-connection",
      "version": "0.2.1-rc.3"
    }
  }
}
