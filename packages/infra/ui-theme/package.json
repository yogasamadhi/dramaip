{
  "name": "@dramaip/infra-ui-theme",
  "description": "Theme plugin: Host bootstrap for the pre-plugin palette; DOM-free ThemeRuntime for light/dark/system state; --dsw-* token styles and Appearance settings row",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./brand-font.css": "./src/styles/brand-font.css",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-remotes": "workspace:*",
    "@dramaip/infra-connection": "workspace:*",
    "@dramaip/infra-locale": "workspace:*",
    "@dramaip/infra-client-shortcuts": "workspace:*",
    "@dramaip/infra-client-store": "workspace:*",
    "@dramaip/infra-ui-primitives": "workspace:*",
    "@dramaip/infra-ui-renderer": "workspace:*",
    "@dramaip/infra-ui-settings": "workspace:*",
    "@dramaip/infra-ui-slots": "workspace:*",
    "@dramaip/infra-webserver": "workspace:*",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "@dramaip/infra-settings": "workspace:*",
    "@dramaip/infra-test-runtime": "workspace:*"
  },
  "dramaip": {
    "client": {
      "inject": [
        "@dramaip/infra-connection",
        "@dramaip/infra-locale",
        "@dramaip/infra-client-shortcuts",
        "@dramaip/infra-ui-renderer",
        "@dramaip/infra-ui-settings",
        "@dramaip/infra-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/client/ui-theme",
      "package": "@deepseek-ai/dsh-client-ui-theme",
      "version": "0.2.1-rc.3"
    }
  }
}
