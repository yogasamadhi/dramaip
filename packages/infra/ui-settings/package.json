{
  "name": "@dramaip/infra-ui-settings",
  "description": "Settings domain base plugin: shared configuration forms and the canonical settings slot-type contract",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-remotes": "workspace:*",
    "@dramaip/infra-client-store": "workspace:*",
    "@dramaip/infra-ui-slots": "workspace:*",
    "@dramaip/infra-settings": "workspace:*",
    "react": "^18.2.0",
    "@dramaip/infra-values": "workspace:*",
    "@dramaip/infra-test-runtime": "workspace:*"
  },
  "dramaip": {
    "client": {
      "inject": [
        "@dramaip/infra-remotes"
      ],
      "platform": "web"
    },
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/client/ui-settings",
      "package": "@deepseek-ai/dsh-client-ui-settings",
      "version": "0.2.1-rc.3"
    }
  }
}
