{
  "name": "@dramaip/infra-config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@dramaip/infra-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@dramaip/infra-app-boot": "workspace:*"
  },
  "dependencies": {
    "@dramaip/infra-atomic-write": "workspace:*",
    "yaml": "^2.8.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@dramaip/infra-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@dramaip/infra-app-boot": "workspace:*"
  },
  "dramaip": {
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/boot/config-editor",
      "package": "@deepseek-ai/dsh-config-editor",
      "version": "0.2.1-rc.3"
    }
  }
