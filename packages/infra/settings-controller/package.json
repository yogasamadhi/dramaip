{
  "name": "@dramaip/infra-settings-controller",
  "description": "Remote owner for the configuration surfaces over the settings-domain seams",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-credentials": "workspace:*",
    "@dramaip/infra-settings": "workspace:*",
    "@dramaip/infra-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:*",
    "zod": "4.4.3",
    "@dramaip/infra-values": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-credentials": "workspace:*",
    "@dramaip/infra-settings": "workspace:*",
    "@dramaip/infra-typert-protocol": "workspace:*"
  },
  "dramaip": {
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/api/settings-controller",
      "package": "@deepseek-ai/dsh-api-settings-controller",
      "version": "0.2.1-rc.3"
    }
  }
}
