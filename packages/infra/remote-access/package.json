{
  "name": "@dramaip/infra-remote-access",
  "description": "Method-level Remote access control for non-owner Peers and the per-Peer access snapshot",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@dramaip/infra-typert-protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/infra-gateway": "workspace:*",
    "@dramaip/infra-connection": "workspace:*",
    "@dramaip/infra-ui-renderer": "workspace:*",
    "@dramaip/infra-ui-slots": "workspace:*",
    "@dramaip/infra-webserver": "workspace:*",
    "@dramaip/infra-typert-registry": "workspace:*"
  },
  "dramaip": {
    "client": {
      "external": [
        "@dramaip/infra-gateway/client"
      ],
      "inject": [
        "@dramaip/infra-gateway",
        "@dramaip/infra-ui-renderer"
      ],
      "platform": "web"
    },
    "copiedFrom": {
      "repository": "vendor/deepseek-harness",
      "path": "packages/api/remote-access",
      "package": "@deepseek-ai/dsh-api-remote-access",
      "version": "0.2.1-rc.3"
    }
  }
}
