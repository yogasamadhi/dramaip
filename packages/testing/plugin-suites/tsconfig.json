{
  "extends": "../../../tsconfig.base.json",
  // The suites boot the web Profile composition, whose packages import
  // `.ts` paths and iterate Web streams (packages/infra/tsconfig.base.json).
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"]
  },
  "include": ["src/**/*.ts"]
}
