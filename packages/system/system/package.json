{
  "name": "@dramaip/system-system",
  "description": "Host face of the system domain: runtime identity, capabilities, redacted diagnostics, the domain event stream and the Desktop Host actions",
  "version": "3.0.0-alpha.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./capabilities": "./src/capabilities.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./handlers/foundation": "./handlers/foundation/index.ts",
    "./handlers/system": "./handlers/system/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "handlers"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@dramaip/contracts": "workspace:*",
    "@dramaip/database": "workspace:*",
    "@dramaip/host-contracts": "workspace:*",
    "@dramaip/infra-typert-protocol": "workspace:*",
    "@dramaip/infra-values": "workspace:*",
    "@dramaip/plugin-api": "workspace:*",
    "@dramaip/seams-engines": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@dramaip/compat-runtime": "workspace:*",
    "@dramaip/infra-storage-relational": "workspace:*",
    "@dramaip/infra-typert-registry": "workspace:*"
  }
}
