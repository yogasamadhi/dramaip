{
  "name": "short-drama-novel-studio",
  "private": true,
  "version": "1.0.0",
  "description": "本地优先的桌面端 AI 写作工具 —— 短剧 IP 小说写作工作台",
  "scripts": {
    "dev": "pnpm --filter @sdns/desktop dev",
    "build": "pnpm -r --filter @sdns/desktop build",
    "preview": "pnpm --filter @sdns/desktop preview",
    "package": "pnpm --filter @sdns/desktop package",
    "db:generate": "pnpm --filter @sdns/db generate",
    "db:push": "pnpm --filter @sdns/db push",
    "rebuild": "pnpm --filter @sdns/desktop rebuild",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20"
  }
}
