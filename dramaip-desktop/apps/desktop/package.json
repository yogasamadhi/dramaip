{
  "name": "@sdns/desktop",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "DramaIP AI 漫剧生产工作室 - 桌面端",
  "author": "sdns",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun --bun run electron-vite dev",
    "build": "bun --bun run electron-vite build",
    "preview": "bun --bun run electron-vite preview",
    "rebuild": "bun run rebuild:electron",
    "rebuild:electron": "bun --bun run electron-rebuild -f -w better-sqlite3",
    "package": "bun run build && bun run rebuild:electron && bun --bun run electron-builder",
    "typecheck:node": "bun --bun run tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "bun --bun run tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.43",
