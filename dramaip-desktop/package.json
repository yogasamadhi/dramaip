{
  "name": "short-drama-novel-studio",
  "private": true,
  "version": "2.0.0-rc.1",
  "description": "本地优先、可审片、可复现、可交付的 AI 漫剧生产工作室",
  "scripts": {
    "dev": "bun run --filter @sdns/desktop dev",
    "build": "bun run --filter @sdns/desktop build",
    "preview": "bun run --filter @sdns/desktop preview",
    "package": "bun run --filter @sdns/desktop package",
    "package:smoke": "bun run scripts/package-smoke.mjs",
    "package:smoke:dir": "bun run scripts/package-smoke.mjs --dir",
    "release:metadata": "bun run scripts/generate-release-metadata.mjs",
    "release:gate": "bun run scripts/v2-release-gate.mjs",
    "test:e2e": "bun run scripts/e2e-smoke.mjs",
    "test:e2e:skip-build": "bun run scripts/e2e-smoke.mjs --skip-build",
    "test:hailuo:sandbox": "node --import tsx scripts/hailuo-sandbox-smoke.ts",
    "test:wan:sandbox": "node --import tsx scripts/wan-sandbox-smoke.ts",
    "test:ui": "bun run scripts/ui-baseline.mjs",
    "test:ui:skip-build": "bun run scripts/ui-baseline.mjs --skip-build",
    "db:generate": "bun run --filter @sdns/db generate",
    "db:push": "bun run --filter @sdns/db push",
    "rebuild": "bun run rebuild:electron",
    "rebuild:electron": "bun run --filter @sdns/desktop rebuild:electron",
    "rebuild:node": "node scripts/rebuild-better-sqlite3-node.mjs",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "lint": "bun run typecheck",
    "format:check": "bun run scripts/check-format.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test": "bun run typecheck && bun run test:unit && bun run test:db"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@electron/get@^3.0.0": "3.1.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "electron-winstaller",
    "esbuild",
    "ffmpeg-static"
  ],
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  }
}
