{
  "name": "short-drama-novel-studio",
  "private": true,
  "version": "2.0.0-rc.1",
  "description": "本地优先、可审片、可复现、可交付的 AI 漫剧生产工作室",
  "scripts": {
    "dev": "pnpm --filter @sdns/desktop dev",
    "build": "pnpm -r --filter @sdns/desktop build",
    "preview": "pnpm --filter @sdns/desktop preview",
    "package": "pnpm --filter @sdns/desktop package",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:smoke:dir": "node scripts/package-smoke.mjs --dir",
    "release:metadata": "node scripts/generate-release-metadata.mjs",
    "release:gate": "node scripts/v2-release-gate.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:skip-build": "node scripts/e2e-smoke.mjs --skip-build",
    "test:hailuo:sandbox": "node --import tsx scripts/hailuo-sandbox-smoke.ts",
    "test:wan:sandbox": "node --import tsx scripts/wan-sandbox-smoke.ts",
    "test:ui": "node scripts/ui-baseline.mjs",
    "test:ui:skip-build": "node scripts/ui-baseline.mjs --skip-build",
    "db:generate": "pnpm --filter @sdns/db generate",
    "db:push": "pnpm --filter @sdns/db push",
    "rebuild": "pnpm rebuild:electron",
    "rebuild:electron": "pnpm --filter @sdns/desktop rebuild:electron",
    "rebuild:node": "node scripts/rebuild-better-sqlite3-node.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm typecheck",
    "format:check": "node scripts/check-format.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test": "pnpm typecheck && pnpm test:unit && pnpm test:db",
    "install:electron": "node apps/desktop/node_modules/electron/install.js --no"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.2.2",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
